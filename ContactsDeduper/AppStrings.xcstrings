    "duplicate.mergeConfirmation": {
      "comment": "duplicate.mergeConfirmation: Match reasons: %@. Confirm that these contacts belong to the same person.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Match reasons: %1$(value1)@. Confirm that these contacts belong to the same person."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "查重依据：%@。请确认这些联系人确实属于同一个人。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "查重依據：%@。請確認這些聯絡人確實屬於同一個人。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "重複チェックの基準: %@。これらの連絡先が本当に同一人物であることを確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "중복 확인 기준: %@. 해당 연락처가 실제로 동일한 사람인지 확인하세요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Base para la verificación de duplicaciones: %@. Confirme que estos contactos son efectivamente la misma persona."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Base du contrôle de duplication : %@. Veuillez confirmer que ces contacts sont bien la même personne."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Grundlage für die Dublettenprüfung: %@. Bitte bestätigen Sie, dass es sich bei diesen Kontakten tatsächlich um dieselbe Person handelt."
          }
        }
      }
    },
