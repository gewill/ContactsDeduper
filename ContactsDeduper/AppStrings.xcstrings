    "backup.contactsHaveBeenDeletedCanBeRestoredFromAPreviouslyExportedBackup": {
      "comment": "backup.contactsHaveBeenDeletedCanBeRestoredFromAPreviouslyExportedBackup: %lld contacts have been deleted. Can be restored from a previously exported backup.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$(value1)lld contacts have been deleted. Can be restored from a previously exported backup."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已删除 %lld 个联系人。可通过之前导出的备份恢复。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已刪除 %lld 個聯絡人。可透過先前匯出的備份還原。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld 件の連絡先が削除されました。以前にエクスポートしたバックアップから復元できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld개의 연락처가 삭제되었습니다. 이전에 내보낸 백업에서 복원할 수 있습니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se han eliminado %lld contactos. Se puede restaurar desde una copia de seguridad exportada previamente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld contacts ont été supprimés. Peut être restauré à partir d'une sauvegarde précédemment exportée."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld Kontakte wurden gelöscht. Kann aus einem zuvor exportierten Backup wiederhergestellt werden."
          }
        }
      }
    },
