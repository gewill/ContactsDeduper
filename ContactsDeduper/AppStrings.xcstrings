    "duplicateList.mergeConfirmation": {
      "comment": "duplicateList.mergeConfirmation: Only the “%@” account will be processed. Members will be added to the kept list before the other lists with the same name are deleted. Contacts will not be deleted.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only the “%1$(value1)@” account will be processed. Members will be added to the kept list before the other lists with the same name are deleted. Contacts will not be deleted."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只处理“%@”账户。成员会汇总到保留的 List，再删除其余同名 List；不会删除联系人。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只處理“%@”帳戶。會員會彙整到保留的 List，再刪除其餘同名 List；不會刪除聯絡人。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」アカウントのみが処理されます。メンバーは保持されたリストにまとめられ、同じ名前の残りのリストは削除されます。連絡先は削除されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\"%@\" 계정만 처리됩니다. 회원은 보유 목록으로 요약되며, 동일한 이름의 나머지 목록은 삭제됩니다. 연락처는 삭제되지 않습니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sólo se procesará la cuenta \"%@\". Los miembros se resumirán en la lista retenida y luego se eliminarán las listas restantes con el mismo nombre; Los contactos no se eliminarán."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seul le compte \"%@\" sera traité. Les membres seront résumés dans la liste conservée, puis les listes restantes portant le même nom seront supprimées ; les contacts ne seront pas supprimés."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es wird nur das Konto „%@“ verarbeitet. Mitglieder werden in der beibehaltenen Liste zusammengefasst und anschließend werden die verbleibenden Listen mit demselben Namen gelöscht. Kontakte werden nicht gelöscht."
          }
        }
      }
    },
    "duplicateList.mergeConfirmationTitle": {
      "comment": "duplicateList.mergeConfirmationTitle: Merge %lld groups of lists with the same name?",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Merge %1$(value1)lld groups of lists with the same name?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
