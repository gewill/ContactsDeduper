            "state": "translated",
            "value": "このアカウントには重複はありません"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 계정에는 중복된 항목이 없습니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay duplicados en esta cuenta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il n'y a aucun doublon dans ce compte"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es gibt keine Duplikate in diesem Konto"
          }
        }
      }
    },
    "backup.backupFilesForVersionAreNotCurrentlySupported": {
      "comment": "backup.backupFilesForVersionAreNotCurrentlySupported: Backup files for version %lld are not currently supported.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Backup files for version %1$(value1)lld are not currently supported."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "暂不支持版本 %lld 的备份文件。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "暫不支援版本 %lld 的備份檔。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "バージョン %lld のバックアップ ファイルは現在サポートされていません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "버전 %lld의 백업 파일은 현재 지원되지 않습니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Actualmente no se admiten archivos de copia de seguridad para la versión %lld."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les fichiers de sauvegarde pour la version %lld ne sont actuellement pas pris en charge."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sicherungsdateien für Version %lld werden derzeit nicht unterstützt."
          }
        }
      }
    },
