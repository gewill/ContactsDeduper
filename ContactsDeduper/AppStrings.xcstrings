    "duplicateList.mergeResult": {
      "comment": "duplicateList.mergeResult: %1$lld groups of lists with the same name have been merged, %2$lld duplicate lists have been deleted, and %3$lld members have been added.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$(value1)lld groups of lists with the same name have been merged, %2$(value2)lld duplicate lists have been deleted, and %3$(value3)lld members have been added."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已合并 %1$lld 组同名 List，删除 %2$lld 个重复 List，并补充 %3$lld 位成员。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已合併 %1$lld 群組同名 List，刪除 %2$lld 個重複 List，並補充 %3$lld 位元成員。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "同じ名前を持つリストの %1$lld グループがマージされ、%2$lld 個の重複リストが削除され、%3$lld メンバーが追加されました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이름이 같은 목록의 %1$lld개 그룹이 병합되었고 %2$lld개의 중복 목록이 삭제되었으며 %3$lld명의 구성원이 추가되었습니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se fusionaron %1$lld grupos de listas con el mismo nombre, se eliminaron %2$lld listas duplicadas y se agregaron %3$lld miembros."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld groupes de listes portant le même nom ont été fusionnés, %2$lld listes en double ont été supprimées et %3$lld membres ont été ajoutés."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld Gruppen von Listen mit demselben Namen wurden zusammengeführt, %2$lld doppelte Listen wurden gelöscht und %3$lld Mitglieder wurden hinzugefügt."
          }
        }
      }
    },
