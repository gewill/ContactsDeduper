    "backup.import.preview": {
      "comment": "backup.import.preview: Backup time: %1$@. There are %2$lld contacts in the file, and %3$lld are expected to be added. Existing contacts will not be deleted or overwritten.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Backup time: %1$(value1)@. There are %2$(value2)lld contacts in the file, and %3$(value3)lld are expected to be added. Existing contacts will not be deleted or overwritten."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "备份时间：%1$@。文件内共 %2$lld 个联系人，预计新增 %3$lld 个。现有联系人不会被删除或覆盖。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "備份時間：%1$@。文件內共 %2$lld 個聯絡人，預計新增 %3$lld 個。現有聯絡人不會被刪除或覆蓋。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "バックアップ時間: %1$@。ファイル内に %2$lld 件の連絡先があり、%3$lld 件が追加される予定です。既存の連絡先は削除されたり上書きされたりしません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "백업 시간: %1$@. 파일에 %2$lld개의 연락처가 있으며 %3$lld개가 추가될 것으로 예상됩니다. 기존 연락처는 삭제되거나 덮어쓰여지지 않습니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiempo de respaldo: %1$@. Hay %2$lld contactos en el archivo y se espera que se agreguen %3$lld. Los contactos existentes no se eliminarán ni se sobrescribirán."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Temps de sauvegarde : %1$@. Il y a %2$lld contacts dans le fichier et %3$lld devraient être ajoutés. Les contacts existants ne seront ni supprimés ni écrasés."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sicherungszeit: %1$@. Die Datei enthält %2$lld Kontakte und es wird erwartet, dass %3$lld hinzugefügt werden. Bestehende Kontakte werden nicht gelöscht oder überschrieben."
          }
        }
      }
    },
