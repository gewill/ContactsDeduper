    "phone.defaultRegion.description": {
      "comment": "phone.defaultRegion.description: The default region is only used for local numbers that do not specify a country or region in the address; it will be re-determined immediately after modification.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The default region is only used for local numbers that do not specify a country or region in the address; it will be re-determined immediately after modification."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "默认地区仅用于地址中未指定国家或地区的本地号码；修改后会立即重新判定。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "預設地區僅用於地址中未指定國家或地區的本地號碼；修改後會立即重新判定。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "デフォルトの地域は、住所に国または地域が指定されていない市内番号にのみ使用されます。変更後すぐに再決定されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기본 지역은 주소에 국가나 지역을 지정하지 않는 지역 번호에만 사용됩니다. 수정 후 즉시 재결정됩니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La región predeterminada solo se usa para números locales que no especifican un país o región en la dirección; se volverá a determinar inmediatamente después de la modificación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La région par défaut n'est utilisée que pour les numéros locaux qui ne spécifient pas de pays ou de région dans l'adresse ; il sera redéterminé immédiatement après modification."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Standardregion wird nur für lokale Nummern verwendet, die in der Adresse kein Land oder keine Region angeben; sie wird unmittelbar nach der Änderung neu ermittelt."
          }
        }
      }
    },
