            "state": "translated",
            "value": "Es müssen noch %lld Gruppen überprüft werden"
          }
        }
      }
    },
    "duplicate.rule.anyField.description": {
      "comment": "duplicate.rule.anyField.description: A matching name, phone number, or email counts as a duplicate",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A matching name, phone number, or email counts as a duplicate"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "名称、电话或邮箱任意一项相同就算重复"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "名稱、電話或郵件信箱任一項相同就算重複"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "名前、電話番号、メールアドレスのいずれかが同じ場合は重複とみなされます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이름, 전화번호, 이메일 주소 중 하나라도 동일할 경우 중복으로 간주됩니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si alguno de los nombres, números de teléfono o direcciones de correo electrónico son iguales, se considerará un duplicado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si l’un des noms, numéros de téléphone ou adresses e-mail est identique, il sera considéré comme un doublon."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn Name, Telefonnummer oder E-Mail-Adresse identisch sind, wird dies als Duplikat betrachtet."
          }
        }
      }
    },
    "duplicate.rule.nameOnly.description": {
      "comment": "duplicate.rule.nameOnly.description: Only look at names, company contacts are compared by company name",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only look at names, company contacts are compared by company name"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只看名称，公司类联系人按公司名比对"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只看名稱，公司類聯絡人依公司名比對"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "名前のみを参照し、会社の連絡先は会社名で比較されます"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이름만 보면 회사연락처는 회사명으로 비교"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mire solo los nombres, los contactos de la empresa se comparan por nombre de la empresa"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Regardez uniquement les noms, les contacts de l'entreprise sont comparés par nom d'entreprise"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schauen Sie sich nur Namen an, Firmenkontakte werden nach Firmennamen verglichen"
          }
        }
      }
    },
    "duplicate.rule.phoneOnly.description": {
      "comment": "duplicate.rule.phoneOnly.description: Only look at the phone number, ignore the name and email address",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only look at the phone number, ignore the name and email address"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只看电话，忽略名称与邮箱"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只看電話，忽略名稱與信箱"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "電話番号だけを見て、名前やメールアドレスは無視してください"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "전화번호만 보고 이름, 이메일 주소는 무시하세요"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mire solo el número de teléfono, ignore el nombre y la dirección de correo electrónico"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Regardez uniquement le numéro de téléphone, ignorez le nom et l'adresse e-mail"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schauen Sie sich nur die Telefonnummer an, ignorieren Sie den Namen und die E-Mail-Adresse"
          }
        }
      }
    },
    "duplicate.rule.twoFields.description": {
      "comment": "duplicate.rule.twoFields.description: At least two of name, phone number, and email must match",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "At least two of name, phone number, and email must match"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "名称、电话、邮箱中至少两项同时相同才算重复"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "名稱、電話、信箱中至少兩項同時相同才算重複"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "名前、電話番号、電子メール アドレスの少なくとも 2 つの項目が同時に同じである場合にのみ、重複が考慮されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이름, 전화번호, 이메일 주소 중 2개 이상의 항목이 동시에 동일한 경우에만 중복으로 간주됩니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo se considerará la duplicación si al menos dos elementos de nombre, número de teléfono y dirección de correo electrónico son iguales al mismo tiempo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La duplication ne sera prise en compte que si au moins deux éléments de nom, numéro de téléphone et adresse e-mail sont identiques en même temps."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Vervielfältigung wird nur berücksichtigt, wenn mindestens zwei Angaben wie Name, Telefonnummer und E-Mail-Adresse gleichzeitig identisch sind."
          }
        }
      }
    },
