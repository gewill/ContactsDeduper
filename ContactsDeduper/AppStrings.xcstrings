    "merge.bulkConfirmation": {
      "comment": "merge.bulkConfirmation: Only the “%@” account will be processed. The most complete contact in each group will be kept and supplemented; the others will be deleted and cannot be recovered. Export a backup first.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only the “%1$(value1)@” account will be processed. The most complete contact in each group will be kept and supplemented; the others will be deleted and cannot be recovered. Export a backup first."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只处理“%@”账户。每组保留资料最完整的一项并补齐资料，其余联系人会被删除且不可撤销。建议先导出备份。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只處理“%@”帳戶。每組保留資料最完整的一項並補齊資料，其餘聯絡人會被刪除且不可撤銷。建議先匯出備份。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」アカウントのみが処理されます。各グループは最も完全な情報を保持し、情報を完成させます。残りの連絡先は取り消し不能に削除されます。最初にバックアップをエクスポートすることをお勧めします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\"%@\" 계정만 처리됩니다. 각 그룹은 가장 완전한 정보를 유지하고 정보를 완성합니다. 나머지 연락처는 취소할 수 없게 삭제됩니다. 먼저 백업을 내보내는 것이 좋습니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sólo se procesará la cuenta \"%@\". Cada grupo conserva la información más completa y completa la información. Los contactos restantes se eliminarán irrevocablemente. Se recomienda exportar la copia de seguridad primero."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seul le compte \"%@\" sera traité. Chaque groupe conserve les informations les plus complètes et complète les informations. Les contacts restants seront définitivement supprimés. Il est recommandé d'exporter d'abord la sauvegarde."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es wird nur das Konto „%@“ verarbeitet. Jede Gruppe behält die umfassendsten Informationen und vervollständigt die Informationen. Die übrigen Kontakte werden unwiderruflich gelöscht. Es wird empfohlen, zuerst das Backup zu exportieren."
          }
        }
      }
    },
