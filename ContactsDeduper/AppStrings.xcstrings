    "deleteAll.confirmationMessage": {
      "comment": "deleteAll.confirmationMessage: This will permanently delete every accessible contact in all accounts. Export a backup first.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This will permanently delete every accessible contact in all accounts. Export a backup first."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此操作会删除所有账户中可访问的联系人且不可撤销。请先导出备份。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此操作會刪除所有帳戶中可存取的聯絡人且不可撤銷。請先匯出備份。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この操作を行うと、アカウント内のアクセス可能な連絡先がすべて削除され、元に戻すことはできません。まずバックアップをエクスポートしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 작업을 수행하면 계정에서 액세스 가능한 모든 연락처가 삭제되며 되돌릴 수 없습니다. 먼저 백업을 내보내십시오."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta acción eliminará todos los contactos accesibles en la cuenta y es irreversible. Primero exporte la copia de seguridad."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette action supprimera tous les contacts accessibles dans le compte et est irréversible. Veuillez d'abord exporter la sauvegarde."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Aktion löscht alle zugänglichen Kontakte im Konto und ist unwiderruflich. Bitte exportieren Sie zuerst das Backup."
          }
        }
      }
    },
