    "account.scanSummary": {
      "comment": "account.scanSummary: %2$lld contacts and Lists in “%1$@” were scanned. Switch the matching rule above; looser rules may find more duplicates.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$(value2)lld contacts and Lists in “%1$(value1)@” were scanned. Switch the matching rule above; looser rules may find more duplicates."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已扫描“%1$@”中的 %2$lld 个联系人和 List。可在上方切换判定标准，放宽后可能找出更多重复项。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已掃描「%1$@」中的 %2$lld 個聯絡人和 List。可在上方切換判定標準，放寬後可能找出更多重複項。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「%1$@」内の %2$lld 件の連絡先とリストがスキャンされました。上記の判定基準を切り替えて緩和することで、より多くの重複を見つけることができます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\"%1$@\"의 %2$lld개의 연락처와 목록이 검사되었습니다. 위의 판단 기준을 전환하고 완화하여 더 많은 중복 항목을 찾을 수 있습니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se han analizado %2$lld contactos y Lists en «%1$@». Una regla de coincidencia menos estricta puede encontrar más duplicados."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$lld contacts et Lists dans « %1$@ » ont été analysés. Une règle de correspondance moins stricte peut trouver davantage de doublons."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$lld Kontakte und Listen in „%1$@“ wurden gescannt. Mit einer lockereren Abgleichregel lassen sich möglicherweise weitere Duplikate finden."
          }
        }
      }
    },
    "account.selectionHint": {
      "comment": "account.selectionHint: Select an account to find duplicates. Scanning and merging stay within the selected account.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Select an account to find duplicates. Scanning and merging stay within the selected account."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "先选择一个账户开始查重；扫描与合并只会在所选账户内进行。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "先選擇一個帳戶開始查重；掃描與合併只會在所選帳戶內進行。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "まず、重複のチェックを開始するアカウントを選択します。スキャンと結合は、選択したアカウント内でのみ実行されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "먼저 중복 확인을 시작하려면 계정을 선택하세요. 스캔 및 병합은 선택한 계정 내에서만 수행됩니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Primero seleccione una cuenta para comenzar a verificar si hay duplicaciones; el escaneo y la combinación solo se realizarán dentro de la cuenta seleccionada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sélectionnez d’abord un compte pour commencer à vérifier les duplications ; l'analyse et la fusion ne seront effectuées qu'au sein du compte sélectionné."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wählen Sie zunächst ein Konto aus, um mit der Prüfung auf Duplikate zu beginnen. Das Scannen und Zusammenführen wird nur innerhalb des ausgewählten Kontos durchgeführt."
          }
        }
      }
    },
    "account.thereAreNoDuplicatesInThisAccount": {
      "comment": "account.thereAreNoDuplicatesInThisAccount: There are no duplicates in this account",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
